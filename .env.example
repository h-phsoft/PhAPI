# PhsAPI environment configuration
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3000

# development | production
# Production tightens validation: warnings about a weak JWT_SECRET become
# hard startup failures, and error responses stop leaking stack traces.
NODE_ENV=development

# Set to true for verbose SQL/debug logging.
DEBUG_MODE=false

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------

# Signs and verifies every JWT the API issues. There is NO fallback default:
# the server refuses to start without it. Use a unique value per environment
# and never reuse the development secret in production.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Minimum 32 characters (enforced in production, warned about in development).
JWT_SECRET=

# Token lifetime, in the format accepted by jsonwebtoken (e.g. 24h, 30m, 7d).
JWT_EXPIRES_IN=24h

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call this API — normally your PhApp hosts.
# Leaving it empty allows any origin, which is permitted in development but
# refused at startup when NODE_ENV=production.
CORS_ORIGINS=http://localhost:3030

# ---------------------------------------------------------------------------
# Authorization (RBAC)
# ---------------------------------------------------------------------------

# Program-level permission checks using the existing Cpy_Perm grants.
#
# A request is matched to a program in one of two ways:
#
#   1. The client sends an 'mprgid' header naming the program it is acting on.
#      The grant is then checked directly on MPrg_Id -- exact, and the only check
#      that works on endpoints with no package/table in the path (attachments,
#      InitForm). PhApp takes the ids from the 'programs' tree getUserProfile
#      returns. Prefer this.
#   2. No header: the requested table is matched against the tables the caller's
#      granted programs bind via MPrg_RelTable. Only tables some active program
#      binds can be denied; everything else passes through, because most programs
#      leave MPrg_RelTable empty.
#
#   off     - no permission checks
#   audit   - resolve permissions and log what WOULD be denied, but allow it
#   enforce - deny with 403
#
# Whether enforce is safe depends entirely on the tenant's data. A user whose
# Cpy_User.PGrp_Id is 0 or less is unrestricted and unaffected; only users in a
# permission group are checked, against the programs Cpy_Perm grants that group.
# Stay on audit until the log shows legitimate traffic resolving cleanly
# (grep the logs for "[Authorize] AUDIT would deny"), then switch to enforce.
RBAC_MODE=audit

# How long a user's resolved program set is cached, in seconds.
RBAC_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Legacy Java front-end compatibility
# ---------------------------------------------------------------------------

# The Java front-end sends a /PhsAPI path prefix (a servlet context path, no
# longer meaningful now the API has its own host) and reaches login and logout
# under older names. While it is true, requests in those shapes are rewritten to
# the canonical paths so the routing table declares each operation only once.
#
# PhApp uses the canonical paths, so set this to false once the Java front-end is
# retired -- then middleware/legacyRoutes.js can be deleted outright.
LEGACY_JAVA_CLIENT=true

# ---------------------------------------------------------------------------
# Documentation portal
# ---------------------------------------------------------------------------

# Serves docs/ at /docs. The mount sits ahead of authentication, so wherever it
# is enabled the whole endpoint surface -- the OpenAPI description and the
# Postman collection included -- is readable by anyone who can reach the host.
# Unset means: on in development, off when NODE_ENV=production.
DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# Audit trail
# ---------------------------------------------------------------------------

# Records create/update/delete events into each tenant's Phs_Logs table.
# Writes are fire-and-forget and never fail a request; a tenant without the
# table trips a breaker after 3 failures instead of logging on every request.
# Set to false to disable entirely.
AUDIT_LOG=true

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Window applied to both limits below, in milliseconds (default 15 minutes).
RATE_LIMIT_WINDOW_MS=900000

# General API budget per IP per window. Set generously: one ERP screen can fan
# out into many lookup calls. /health is exempt.
RATE_LIMIT_MAX=1000

# Login attempts per IP per window. Successful logins are not counted, so this
# only bites on repeated failures.
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Default tenant database
# ---------------------------------------------------------------------------

# The database engine, chosen once at setup. One engine is active for the whole
# process: this selects the SQL builder, the driver, and how a tenant is
# resolved. An unsupported value stops the server at startup rather than
# surfacing as a driver error on the first query.
#
#   oracle    | a copy is a schema user inside one database; Phs_Cpy.OUser and
#             | OPass are its login credentials
#   postgres  | a copy is its own database, named DB_TENANT_PREFIX + copy
#   mysql     | same as postgres
#
# Accepted aliases: postgresql and pg map to postgres, mariadb maps to mysql.
DB_TYPE=oracle

DB_HOST=localhost

# Defaults to 1521 for oracle, 3306 otherwise.
DB_PORT=1521

DB_USER=
DB_PASSWORD=
DB_NAME=xe

# Oracle only: full connect string. Overrides DB_HOST/DB_PORT/DB_NAME when set.
# DB_CONNECT_STRING=localhost:1521/xe

# Max pooled connections per tenant.
DB_POOL_LIMIT=10

# ---------------------------------------------------------------------------
# Multi-tenant resolution (Oracle admin database)
# ---------------------------------------------------------------------------

# Tenant credentials are looked up in the Phs_Cpy table of the admin database.
# These fall back to the DB_* values above when unset.

# ADMIN_DB_CONNECT_STRING=localhost:1521/xe
# ADMIN_DB_USER=c##erpAdmin
# ADMIN_DB_PASS=

# ORACLE ONLY. Prefix used to derive a tenant schema user when Phs_Cpy has no
# explicit credentials — e.g. copy "MKM" resolves to user "c##erpMKM".
DB_USER_PREFIX=c##erp

# POSTGRES AND MYSQL ONLY. On these engines a copy is a separate database rather
# than a schema user, so the name is derived from this prefix: copy "Demo"
# resolves to the database "phsoftme_erp_demo". Phs_Cpy in the admin database is
# still consulted, so an unknown copy is rejected rather than silently pointed at
# a database that may not exist.
DB_TENANT_PREFIX=phsoftme_erp_

# The registry database holding Phs_Cpy. Defaults to DB_NAME.
# ADMIN_DB_NAME=phsoftme_erp_admin

# ---------------------------------------------------------------------------
# Query behaviour
# ---------------------------------------------------------------------------

# Default row cap for autocomplete lookups when the request sends no pageSize.
# Defaults to 50 when unset.
AUTOCOMPLETE_SIZE=25

# Hard ceiling on rows any single List/Search/Find page may return, so one
# request cannot pull an entire table.
MAX_PAGE_SIZE=1000
